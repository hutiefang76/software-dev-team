    },
    {
      "process": "计划",
      "owner_role": "DM",
      "inputs": [
        "brief-v1",
        "interface-v1",
        "risk-v1",
        "资源日历与费率"
      ],
      "tools_techniques": [
        "RACI",
        "WBS",
        "三点估算",
        "容量排程"
      ],
      "outputs": [
        "baseline-v1"
      ],
      "gate": "冲突已展示，用户批准前是估算"
    },
    {
      "process": "实施",
      "owner_role": "TL",
      "inputs": [
        "baseline-v1",
        "interface-v1",
        "acceptance-v1"
      ],
      "tools_techniques": [
        "最小实现",
        "契约/集成验证"
      ],
      "outputs": [
        "build-v1",
        "implementation-evidence-v1"
      ],
      "gate": "验收可追踪，接口变更已处理"
    },
    {
      "process": "测试",
      "owner_role": "QA",
      "inputs": [
        "acceptance-v1",
        "build-v1",
        "implementation-evidence-v1"
      ],
      "tools_techniques": [
        "风险测试",
        "缺陷复现"
      ],
      "outputs": [
        "acceptance-report-v1",
        "defects-v1"
      ],
      "gate": "每个必需项有实际状态"
    },
    {
      "process": "交接",
      "owner_role": "OPS",
      "inputs": [
        "build-v1",
        "acceptance-report-v1",
        "发布授权（如需）"
      ],
      "tools_techniques": [
        "制品校验",
        "回滚演练"
      ],
      "outputs": [
        "handoff-v1"
      ],
      "gate": "用户能取得制品和已知限制"
    },
    {
      "process": "变更",
      "owner_role": "DM",
      "inputs": [
        "baseline-v1",
        "实际消耗",
        "剩余估算",
        "新范围"
      ],
      "tools_techniques": [
        "影响分析",
        "预测重算"
      ],
      "outputs": [
        "forecast-v2",
        "change-decision"
      ],
      "gate": "授权后才修改承诺基线"
    },
    {
      "process": "复盘",
      "owner_role": "TL",
      "inputs": [
        "defects-v1",
        "handoff-v1",
        "实际消耗"
      ],
      "tools_techniques": [
        "根因分析"
      ],
      "outputs": [
        "improvement-record"
      ],
      "gate": "只固化有证据的改进"
    }
