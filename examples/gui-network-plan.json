      ],
      "gate": "用户能取得制品和已知限制"
    },
    {
      "process": "变更",
      "owner_role": "DM",
      "inputs": [
        "baseline-v1",
        "实际消耗",
        "剩余估算",
        "新范围"
      ],
      "tools_techniques": [
        "影响分析",
        "预测重算"
      ],
      "outputs": [
        "forecast-v2",
        "change-decision"
      ],
      "gate": "授权后才修改承诺基线"
    },
    {
      "process": "复盘",
      "owner_role": "TL",
      "inputs": [
        "defects-v1",
        "handoff-v1",
        "实际消耗"
      ],
      "tools_techniques": [
        "根因分析"
      ],
      "outputs": [
